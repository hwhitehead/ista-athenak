# AthenaK input file for 3d isothermal circumbinary disk

<comment>
problem   = cbdiso_3d

<job>
basename  = chkpt      # problem ID: basename of output filenames

<mesh>
nghost    = 4          # Number of ghost cells (must be even for SMR/AMR)
nx1       = 80         # Number of zones in X1-direction (root level, dx=0.1)
x1min     = -2.5       # minimum value of X1
x1max     =  2.5       # maximum value of X1
ix1_bc    = outflow    # inner-X1 boundary flag
ox1_bc    = outflow    # outer-X1 boundary flag

nx2       = 120        # Number of zones in X2-direction (root level, dx=0.1)
x2min     = -4.0       # minimum value of X2
x2max     =  4.0       # maximum value of X2
ix2_bc    = outflow    # inner-X2 boundary flag
ox2_bc    = outflow    # outer-X2 boundary flag

nx3       = 120        # Number of zones in X3-direction (root level, dx=0.1)
x3min     = -4.0       # minimum value of X3
x3max     =  4.0       # maximum value of X3
ix3_bc    = outflow    # inner-X3 boundary flag
ox3_bc    = outflow    # outer-X3 boundary flag

<meshblock>
nx1       = 80          # Number of cells in each MeshBlock, X1-dir
nx2       = 120         # Number of cells in each MeshBlock, X2-dir
nx3       = 12          # Number of cells in each MeshBlock, X3-dir

<mesh_refinement>
refinement = static     # static mesh refinement (SMR)

<refined_region1>
x1min = -1.0            # level-1 region: dx=dy=dz=0.02
x1max =  1.0
x2min = -2.0
x2max =  2.0
x3min = -2.0
x3max =  2.0
level = 1

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk2        # time integration algorithm
cfl_number = 0.2        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 50.0       # time limit
ndiag      = 1          # cycles between diagostic output

<hydro>
eos         = ideal     # EOS type
reconstruct = ppm4      # spatial reconstruction method
rsolver     = hlle      # Riemann-solver to be used
gamma       = 1.000001    # gamma = C_p/C_v

<problem>
a_binary       = 1.0
q_mass         = 1.0
eccentricity   = 0.5
r_soft         = 0.1
r_sink         = 0.05
m_total        = 1.0
sink_rate      = 1.0
sink_model     = 2
Mach           = 10.0
alpha          = 0.2
orientation    = 90.0
cavity_radius  = 1.0

floor_density  = 1e-10
floor_pressure = 1e-12


<output1>
file_type  = bin        # native binary data dump (vtk writer doesn't support SMR/AMR)
variable   = hydro_w    # variables to be output
dt         = 0.1        # time increment between outputs


<output2>
file_type  = rst        # vtk data dump
dt         = 1.0        # time increment between outputs


<output3>
file_type  = hst        # history data dump
dt         = 0.01        # time increment between outputs
